class_name FloraData
extends Resource

@export_group("Identification")
@export var id: String = ""
@export var display_name: String = ""
@export_multiline var description: String = ""
@export var icon: Texture2D

@export_group("Unlock Conditions")
## Minimum Tree of Life level required to unlock this flora
@export var required_tree_level: int = 1

@export_group("Passive Economy")
## Planting or upgrading cost for this flora element
@export var base_cost: float = 15.0
## Cost multiplier per level
@export var cost_multiplier: float = 1.10
## Passive vitality per second produced by each level of this flora
@export var passive_vitality_per_sec: float = 1.0

@export_group("Click Economy")
## Click vitality bonus produced by each level of this flora (optional)
@export var click_power_per_level: float = 1.0

@export_group("Visual 3D")
@export var model_scene: PackedScene

## Calculates cost to buy or upgrade to the next level
func get_cost_for_level(current_level: int) -> float:
	return base_cost * pow(cost_multiplier, current_level)

## Calculates total passive production generated by this flora at current level
func get_total_production(current_level: int) -> float:
	return passive_vitality_per_sec * current_level

## Calculates total click bonus generated by this flora at current level
func get_total_click_bonus(current_level: int) -> float:
	return click_power_per_level * current_level
