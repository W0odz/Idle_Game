extends Node

## Signals for the 3D scene and UI to react to economy purchases
signal player_tapped(earned_amount: float)
signal dino_spawned(dino_data: DinoData, total_owned: int)
signal flora_upgraded(flora_data: FloraData, current_level: int)
signal tree_upgraded(tree_data: TreeOfLifeData, current_level: int)

## Central active economy element (Tree of Life)
@export var tree_data: TreeOfLifeData
var tree_level: int = 1

## Fallback base click power if no TreeOfLifeData is assigned
@export var base_click_power: float = 1.0

## Inventories: [ID (String) -> Amount / Level (int)]
var owned_dinos: Dictionary = {}
var owned_flora: Dictionary = {}

## Catalogues: [ID (String) -> ResourceData]
@export var dino_catalog: Dictionary = {}   # id -> DinoData
@export var flora_catalog: Dictionary = {}  # id -> FloraData

func _ready() -> void:
	load_catalogs()
	recalculate_economy()

## Automatically loads .tres resource files from their respective data folders
func load_catalogs() -> void:
	# Load Tree of Life from res://Data/Tree/ (accepts any .tres file in that folder)
	if not tree_data:
		var tree_list = _load_resources_from_dir("res://Data/Tree")
		if not tree_list.is_empty() and tree_list[0] is TreeOfLifeData:
			tree_data = tree_list[0]

	# Load Flora resources from res://Data/Flora/ (accepts any .tres file name)
	for res in _load_resources_from_dir("res://Data/Flora"):
		if res is FloraData and not res.id.is_empty():
			flora_catalog[res.id] = res

	# Load Dinosaur resources from res://Data/Dinos/ (accepts any .tres file name)
	for res in _load_resources_from_dir("res://Data/Dinos"):
		if res is DinoData and not res.id.is_empty():
			dino_catalog[res.id] = res

## Helper method to read all .tres files inside a given directory
func _load_resources_from_dir(dir_path: String) -> Array[Resource]:
	var result: Array[Resource] = []
	var dir = DirAccess.open(dir_path)
	if not dir:
		return result
		
	dir.list_dir_begin()
	var file_name = dir.get_next()
	while file_name != "":
		# Filter only .tres files (ignoring subdirectories and import files)
		if not dir.current_is_dir() and file_name.ends_with(".tres"):
			var full_path = dir_path.path_join(file_name)
			var res = load(full_path)
			if res:
				result.append(res)
		file_name = dir.get_next()
	dir.list_dir_end()
	return result

func _process(delta: float) -> void:
	# Continuous passive production generated by flora and amplified by dinos
	if CurrencyManager.vitality_per_second > 0.0:
		CurrencyManager.add_vitality(CurrencyManager.vitality_per_second * delta, false)

## Called when the player taps the screen or clicks the Tree of Life
func perform_click() -> float:
	var earned: float = CurrencyManager.vitality_per_click
	CurrencyManager.add_vitality(earned, true)
	player_tapped.emit(earned)
	return earned

## Upgrades the central Tree of Life (Active Click Power)
func buy_tree_upgrade() -> bool:
	if not tree_data:
		push_warning("TreeOfLifeData is not assigned in GameManager.")
		return false
		
	var cost: float = tree_data.get_cost_for_level(tree_level)
	if CurrencyManager.spend_vitality(cost):
		tree_level += 1
		recalculate_economy()
		tree_upgraded.emit(tree_data, tree_level)
		return true
		
	return false

## Returns current cost to upgrade the Tree of Life
func get_tree_upgrade_cost() -> float:
	if tree_data:
		return tree_data.get_cost_for_level(tree_level)
	return 0.0

## Purchases an instance of a dinosaur species (Multiplier to Final Production)
func buy_dino(dino_id: String) -> bool:
	if not dino_catalog.has(dino_id):
		push_warning("Dinosaur not found in catalog: %s" % dino_id)
		return false
		
	var data: DinoData = dino_catalog[dino_id]
	var current_count: int = owned_dinos.get(dino_id, 0)
	var cost: float = data.get_cost_for_next(current_count)
	
	if CurrencyManager.spend_vitality(cost):
		owned_dinos[dino_id] = current_count + 1
		recalculate_economy()
		dino_spawned.emit(data, owned_dinos[dino_id])
		return true
		
	return false

## Purchases or levels up a flora element (Passive Income)
func buy_flora(flora_id: String) -> bool:
	if not flora_catalog.has(flora_id):
		push_warning("Flora not found in catalog: %s" % flora_id)
		return false
		
	var data: FloraData = flora_catalog[flora_id]
	var current_level: int = owned_flora.get(flora_id, 0)
	var cost: float = data.get_cost_for_level(current_level)
	
	if CurrencyManager.spend_vitality(cost):
		owned_flora[flora_id] = current_level + 1
		recalculate_economy()
		flora_upgraded.emit(data, owned_flora[flora_id])
		return true
		
	return false

## Calculates the total production multiplier provided by all owned dinosaurs
func get_total_dino_multiplier() -> float:
	var total_bonus: float = 0.0
	for dino_id in owned_dinos:
		var count: int = owned_dinos[dino_id]
		if dino_catalog.has(dino_id):
			var data: DinoData = dino_catalog[dino_id]
			total_bonus += data.get_total_bonus(count)
	return 1.0 + total_bonus

## Recalculates both vitality per second and vitality per click
func recalculate_economy() -> void:
	# 1. CLICK POWER CALCULATION (Driven by Tree of Life)
	var total_click: float = base_click_power
	if tree_data:
		total_click = tree_data.get_click_power(tree_level)
			
	# 2. BASE PASSIVE INCOME (Sum of all flora elements producing vitality/s)
	var base_passive: float = 0.0
	for flora_id in owned_flora:
		var level: int = owned_flora[flora_id]
		if flora_catalog.has(flora_id):
			var data: FloraData = flora_catalog[flora_id]
			base_passive += data.get_total_production(level)
			
	# 3. FINAL PASSIVE PRODUCTION (Amplified by dinosaur multiplier)
	var dino_multiplier: float = get_total_dino_multiplier()
	var total_passive: float = base_passive * dino_multiplier
			
	# 4. Update final rates in CurrencyManager
	CurrencyManager.set_rates(total_passive, total_click)
